{
  "name": "pi-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Personal extensions, skills, prompts, and themes for pi.",
  "type": "module",
  "exports": {
    "./subagent-profile": {
      "types": "./extensions/subagents/api.ts"
    }
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "format": "biome check --write .",
    "format:check": "biome check --linter-enabled=false .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm test"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "20.19.37",
    "knip": "5.88.1",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "pi": {
    "extensions": [
      "./extensions/timing",
      "./extensions/subagents",
      "./extensions/context-usage",
      "./extensions/handoff"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  }
}
